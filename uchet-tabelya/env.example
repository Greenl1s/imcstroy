# Заполняется для развёртывания с HTTPS за обратным прокси.
# Для локального запуска оставьте http://127.0.0.1:3180.
APP_ORIGIN=http://127.0.0.1:3180
# Для files.imcstroy.ru/tabel/: APP_ORIGIN=https://files.imcstroy.ru и APP_BASE_PATH=/tabel
APP_BASE_PATH=
# Порт на сервере занят? Измените его здесь, а для HTTP-теста — и в APP_ORIGIN.
TIMESHEET_PORT=3180
# Только для запуска с compose.proxy.yml: имя существующей сети контейнера Caddy.
# TIMESHEET_PROXY_NETWORK=imcstroy_default
# Необязательно: свой секрет первоначальной настройки.
# Если пусто, Docker-версия выведет случайный код в консоль первого запуска.
SETUP_TOKEN=
