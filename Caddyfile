{$SITE_ADDRESS} {
        encode gzip

        handle /api/* {
                reverse_proxy api:3000
        }

        handle {
                root * /srv/web
                try_files {path} /index.html
                file_server
        }

        header {
                X-Content-Type-Options nosniff
                X-Frame-Options DENY
                Referrer-Policy same-origin
                # Говорит браузеру полгода ходить сюда только по https —
                # защищает от подмены соединения на первом же заходе.
                Strict-Transport-Security "max-age=15768000"
                -Server
        }

        log {
                output stdout
                format console
        }
}

files.{$SITE_ADDRESS} {
        encode gzip

        redir /instruments /instruments/ permanent

        handle /instruments/api/* {
                uri strip_prefix /instruments
                reverse_proxy api:3000
        }

        handle /instruments/* {
                uri strip_prefix /instruments
                root * /srv/web
                try_files {path} /index.html
                file_server
        }

        handle {
                reverse_proxy filemanager:3000
        }

        header {
                X-Content-Type-Options nosniff
                X-Frame-Options SAMEORIGIN
                Referrer-Policy same-origin
                Strict-Transport-Security "max-age=15768000"

                # Запасной рубеж против выполнения чужого кода на странице.
                # Пока в режиме "только жалобы": браузер ничего не блокирует,
                # но пишет нарушения в консоль. Открой файловый менеджер и
                # документ через OnlyOffice, посмотри консоль (F12) — если
                # жалоб нет, переименуй заголовок в
                # Content-Security-Policy, и правило начнёт действовать.
                Content-Security-Policy-Report-Only "default-src 'self'; script-src 'self' https://office.{$SITE_ADDRESS}; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://office.{$SITE_ADDRESS}; frame-src 'self' https://office.{$SITE_ADDRESS}; object-src 'none'; base-uri 'self'; form-action 'self'"
                -Server
        }
        log {
                output stdout
                format console
        }
}

office.{$SITE_ADDRESS} {
        reverse_proxy onlyoffice:80

        header {
                X-Content-Type-Options nosniff
                -Server
        }

        log {
                output stdout
                format console
        }
}
